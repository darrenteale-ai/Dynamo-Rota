# Copy this file to .env and fill in real values before running in production.

# Required
JWT_SECRET=change-this-to-a-long-random-string
PORT=4000

# Where the SQLite database file is written
DB_PATH=./data/rota.db

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Optional: enable real email notifications alongside the in-app bell.
# If left blank, the app runs fine — it just skips sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dynamo <rota@example.com>"

# Set to "true" the very first time you deploy to seed demo staff.
# Set back to "false" (or remove) after first run so it never re-seeds.
SEED_DEMO_DATA=true
